# Copy to .env for LOCAL use only. Never commit .env.
# On hosting (Cloud Run / Render / Railway) set these as environment variables / secrets instead.
PORT=8080
GEMINI_API_KEY=put-your-key-here
# Verify the exact model name in Google AI Studio before the demo (a Flash-class model is recommended).
GEMINI_MODEL=gemini-2.5-flash
# Public app identifier sent by the Flutter app in X-App-Key (not a secret, just blocks random traffic).
APP_PUBLIC_KEY=haqooq-demo-app
ALLOWED_ORIGINS=*
